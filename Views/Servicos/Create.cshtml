@model Ordem_Servicos_Web.Models.Servico

@{
    ViewData["Title"] = "Novo Serviço";
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<partial name="_MensagemToast" />

<div class="d-flex justify-content-center align-items-center ">
    <div class="card-form">
        <div class="card-body">
            <form asp-action="Create" class="novo" method="post" id="formServico" enctype="multipart/form-data"
                  data-campos-obrigatorios="IdCodigoBase,
                                           categoriaServicoSelect,
                                           Descricao">

                <!-- Descrição da Servico -->
                <div class="row mb-2 g-4">
                    <div class="col-auto">
                        <label asp-for="IdCodigoBase" class="label-destaque">Código Base do Serviço</label>
                        <input asp-for="IdCodigoBase" class="form-control text-uppercase maiusculo idCodigoBase" id="IdCodigoBase" style="width:250px;" data-focus="true" />
                    </div>
                    <div class="col-auto">
                        <label class="label-destaque">Categoria de Serviço</label>
                        <select asp-for="IdCategoriaServico" class="form-control categoriaServicoSelect" style="width:616px;" id="categoriaServicoSelect">
                            <option value="">-- Clique para carregar Categorias --</option>
                        </select>
                    </div>
                </div>

                <div class="row mb-2 g-4">
                    <div class="col-auto">
                        <label asp-for="Descricao" class="label-destaque">Descrição do Serviço</label>
                        <input asp-for="Descricao" class="form-control text-uppercase maiusculo descricaoServico" id="Descricao" style="width:615px;" />
                    </div>
                    <div class="col-auto">
                        <label asp-for="ValorServico" class="label-destaque">Valor do Serviço</label>
                        <input asp-for="ValorServico" type="text" inputmode="numeric" class="form-control text-end valor" id="ValorServico" style="width:250px;" />
                    </div>
                </div>

                <!-- Botões -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" id="btnSalvar" class="btn-gradiente btn-gradiente-salvar">
                        <i class="fa fa-floppy-disk move-icone-esq"></i> Salvar Servico
                    </button>
                    <a asp-action="Index" class="btn-gradiente btn-gradiente-cancelar">
                        <i class="fa fa-undo move-icone-esq"></i> Cancelar/Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            bloquearMenu();

            const valorServico = document.getElementById("ValorServico");
            const btnSalvar = document.getElementById("btnSalvar");
            const form = document.getElementById("formServico");

            const camposObrigatorios = [
                "Descricao",
                "IdCodigoBase",
                "categoriaServicoSelect"
            ];

            if (valorServico) aplicarMascaraCampo(valorServico, "valor");

            if (form) {
                ValidacaoUtils.configurarValidacaoCampos(form, camposObrigatorios, "SERVICOS");

                if (window.FormUtils && typeof FormUtils.enableEnterNavigation === 'function') {
                    FormUtils.enableEnterNavigation(form, { allowTextarea: true });
                }
            }

            if (btnSalvar && form) {
                btnSalvar.addEventListener("click", function(e) {
                    btnSalvar.focus();
                    const enterEvent = new KeyboardEvent("keydown", {
                        key: "Enter",
                        code: "Enter",
                        bubbles: true
                    });
                    btnSalvar.dispatchEvent(enterEvent);
                    form.requestSubmit();
                });

                btnSalvar.addEventListener("keydown", function(e) {

                    if (e.key === "Enter") {
                        form.requestSubmit();
                    }
                });
            }
        });
    </script>
}