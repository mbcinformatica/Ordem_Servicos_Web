@model IEnumerable<Ordem_Servicos_Web.Models.Servico>

@foreach (var servico in Model)
{
    <tr>
        <td>
             <a asp-action="Alterar" asp-route-id="@servico.IdServico" class="btn-gradiente btn-gradiente-alterar btn-gradiente-sm">
                <i class="fa fa-edit move-icone-esq"></i> Alterar
            </a>
             <a asp-action="Excluir" asp-route-id="@servico.IdServico" class="btn-gradiente btn-gradiente-excluir btn-gradiente-sm">
                <i class="fa fa-trash move-icone-esq"></i> Excluir
            </a>
        </td>
        <td class="text-end">@servico.IdServico</td>
        <td>@servico.IdCodigoBase</td>
        <td>@servico.CategoriaServico?.Descricao</td>
        <td>@servico.Descricao</td>
        <td class="text-end">@servico.ValorServicoFormatado</td>
    </tr>
}
