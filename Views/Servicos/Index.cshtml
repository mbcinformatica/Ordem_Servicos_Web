@model IEnumerable<Ordem_Servicos_Web.Models.Servico>

@{
    ViewData["Title"] = "Gerenciamento de Serviços";
    int page = ViewBag.Page ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    string search = ViewBag.Search ?? "";
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<div class="d-flex justify-content-center align-items-center ">
    <div class="card-form card-form-width">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <input type="text" id="searchBox" value="@search"
                           class="input-pesquisa"
                           placeholder="Pesquisar..." style="max-width:450px;" />
                </div>
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <a class="btn-gradiente btn-gradiente-navegacao me-2 @(page == 1 ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@search">
                        <i class="fa fa-arrow-left move-icone-esq"></i> Anterior
                    </a>
                    <span class="fw-bold text-black me-2">Página: @(page) - @totalPaginas</span>
                    <a class="btn-gradiente btn-gradiente-navegacao me-3 @(page == totalPaginas ? "disabled" : "")"
                       asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@search"> Próximo 
                       <i class="fa fa-arrow-right move-icone-dir"></i>
                    </a>
                    <span id="totalRegistros" class="fw-bold text-black me-2">
                        Total de Registros: @totalRegistros
                    </span>
                    <a asp-action="Create" class="btn-gradiente btn-gradiente-novo">
                        <i class="fa fa-plus move-icone-esq"></i> Novo Registro
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn-gradiente btn-gradiente-cancelar" onclick="liberarMenu()">
                        <i class="fa fa-home move-icone-esq"></i> Voltar a Página Inicial
                    </a>
                </div>
            </div>

            <div class="table-responsive table-responsive-cust">
                <table class="table-os table-os-striped table-os-bordered table-os-condensed w-100 mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th style="width:150px;">Ações</th>
                            <th class="sortable" style="width:100px;">ID</th>
                            <th class="sortable">CÓDIGO BASE</th>
                            <th class="sortable">DESCRIÇÃO CATEGORIA SERVIÇOS</th>
                            <th class="sortable">DESCRIÇÃO SERVIÇOS</th>
                            <th>VALOR DO SERVIÇOS</th>
                        </tr>
                    </thead>
                    <tbody id="servicosTable">
                        @foreach (var servico in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Alterar" asp-route-id="@servico.IdServico" class="btn-gradiente btn-gradiente-alterar btn-gradiente-sm">
                                        <i class="fa fa-edit move-icone-esq"></i> Alterar
                                    </a>
                                    <a asp-action="Excluir" asp-route-id="@servico.IdServico" class="btn-gradiente btn-gradiente-excluir btn-gradiente-sm">
                                        <i class="fa fa-trash move-icone-esq"></i> Excluir
                                    </a>
                                </td>
                                <td class="text-end">@servico.IdServico</td>
                                <td>@servico.IdCodigoBase</td>
                                <td>@servico.CategoriaServico?.Descricao</td>
                                <td>@servico.Descricao</td>
                                <td class="text-end">@servico.ValorServicoFormatado</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <!-- Importa o arquivo JS reutilizável -->
    <script src="~/js/PesquisaDinamica.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            bloquearMenu();

            initSortableTable({
                tableSelector: "table",
                searchBoxSelector: "#searchBox",
                targetTableBody: "#servicosTable",
                totalRegSelector: "#totalRegistros",
                colMap: {
                    1: "IdServico",
                    2: "IdCodigoBase",
                    3: "CategoriaServicoDescricao",
                    4: "Descricao"
                },
                initialCol: 4,              // começa em NomeRazaoSocial
                initialDirection: true,     // ascendente
                searchUrl: '@Url.Action("Search", "Servicos")',
                indexUrl: '@Url.Action("Index", "Servicos", new { page = 1 })',
                defaultSearchColumn: "Descricao",
                placeholders: {
                    "IdServico": "Pesquisar Servico por ID...",
                    "IdCodigoBase": "Pesquisar Servico por Código Base...",
                    "CategoriaServicoDescricao": "Pesquisar Servico por Categoria...",
                    "Descricao": "Pesquisar Servico por Descrição..."
                }
            });
        });
    </script>
}