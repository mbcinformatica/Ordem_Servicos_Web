@model IEnumerable<Ordem_Servicos_Web.Models.CategoriaServico>

@foreach (var categoriaServico in Model)
{
    <tr>
        <td>
             <a asp-action="Alterar" asp-route-id="@categoriaServico.IdCategoriaServico" class="btn-gradiente btn-gradiente-alterar btn-gradiente-sm">
                <i class="fa fa-edit move-icone"></i> Alterar
            </a>
             <a asp-action="Excluir" asp-route-id="@categoriaServico.IdCategoriaServico" class="btn-gradiente btn-gradiente-excluir btn-gradiente-sm">
                <i class="fa fa-trash move-icone"></i> Excluir
            </a>
        </td>
        <td class="text-end">@categoriaServico.IdCategoriaServico</td>
        <td>@categoriaServico.Descricao</td>
    </tr>
}
