@model IEnumerable<Ordem_Servicos_Web.Models.Modelo>

@foreach (var modelo in Model)
{
    <tr>
        <td>
             <a asp-action="Alterar" asp-route-id="@modelo.IdModelo" class="btn-gradiente btn-gradiente-alterar btn-gradiente-sm">
                <i class="fa fa-edit move-icone-esq"></i> Alterar
            </a>
             <a asp-action="Excluir" asp-route-id="@modelo.IdModelo" class="btn-gradiente btn-gradiente-excluir btn-gradiente-sm">
                <i class="fa fa-trash move-icone-esq"></i> Excluir
            </a>
        </td>
        <td class="text-end">@modelo.IdModelo</td>
        <td>@modelo.Marca?.Descricao</td>
        <td>@modelo.Descricao</td>
    </tr>
}
