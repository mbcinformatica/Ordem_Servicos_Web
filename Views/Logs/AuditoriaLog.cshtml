@model IEnumerable<Ordem_Servicos_Web.Models.Log>

@{
    ViewData["Title"] = "Consulta de Logs";
    int page = ViewBag.Page ?? 1;
    int totalPaginas = ViewBag.TotalPaginas ?? 1;
    int totalRegistros = ViewBag.TotalRegistros ?? 0;
    string search = ViewBag.Search ?? "";
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>


<div class="d-flex justify-content-center align-items-center ">
    <div class="card-form card-form-width">
        <div class="card-body">
            <form asp-action="AuditoriaLog" method="get" id="formConsultaLogs" enctype="multipart/form-data" data-campos-obrigatorios="">            
                <div class="row table-responsive-cust">                
                    <div class="col-md-3">
                        <label for="inicio" class="label-destaque">Data de Inicio</label>
                        <input for="inicio" id="inicio" type="date" name="inicio" class="form-control" />
                    </div>                     
                    <div class="col-md-3">
                        <label for="fim" class="label-destaque">Data Fim</label>
                        <input for="fim" id="fim" type="date" name="fim" class="form-control" />
                    </div>            
                    <div class="col-md-3">
                        <label for="usuarioSelect" class="label-destaque">Nome do Usuário</label>
                        <select name="usuario" class="form-select usuarioSelect" id="usuarioSelect">
                            <option value="">-- Clique para carregar Usuários --</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="Acao" class="label-destaque">Ação</label>
                        <select name="acao" id="Acao" class="form-select">
                            <option value="">-- Selecione --</option>
                            <option value="Alterar">Alteração de Registro</option>
                            <option value="Backup">Cópia de Segurança</option>
                            <option value="Criar">Inclusão de Registro</option>
                            <option value="Excluir">Exclusão de Registro</option>
                            <option value="Login">Acesso ao Sistema</option>
                            <option value="Restaurar">Restaurar Backup</option>
                        </select>
                    </div>
                </div>
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div>
                         <button type="submit" class="btn-gradiente btn-gradiente-filtrar">
                         <i class="fa fa-filter move-icone-esq"></i> Filtrar
                         </button>
                         <a href="#" class="btn-gradiente btn-gradiente-imprimir">
                        <i class="fa fa-print move-icone-esq"></i> Imprimir Logs
                    </a>
                         <a asp-controller="Home" asp-action="Index" class="btn-gradiente btn-gradiente-cancelar" onclick="liberarMenu()">
                        <i class="fa fa-home move-icone-esq"></i> Voltar
                    </a>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <a class="btn-gradiente btn-gradiente-navegacao me-2 @(page <= 1 ? "disabled" : "")"
                          asp-action="AuditoriaLog" asp-route-page="@(page - 1)" asp-route-search="@search">
                            <i class="fa fa-arrow-left move-icone-esq"></i> Anterior
                        </a>
                        <span class="fw-bold text-black me-2">Página: @(page) - @totalPaginas</span>
                        <a class="btn-gradiente btn-gradiente-navegacao me-3 @(page >= totalPaginas ? "disabled" : "")"
                          asp-action="AuditoriaLog" asp-route-page="@(page + 1)" asp-route-search="@search"> Próximo 
                          <i class="fa fa-arrow-right move-icone-dir"></i>
                        </a>
                        <span id="totalRegistros" class="fw-bold text-black me-2">
                          Total de Registros: @totalRegistros
                        </span>


                      </div>
                </div>
            </form>
            <div class="table-responsive mt-3">
                <table class="table-os table-os-striped table-os-bordered table-os-condensed w-100 mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>DATA/HORA</th>
                            <th>NÍVEL</th>
                            <th>MENSAGEM</th>
                            <th>USUÁRIO</th>
                            <th>AÇÃO</th>
                            <th>TABELA</th>
                            <th>CÓDIGO REGISTRO</th>
                            <th>OBSERVAÇÕES</th>
                        </tr>
                    </thead>
                    <tbody id="logsTable">
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>@log.Level</td>
                                <td>@log.Message</td>
                                <td>@log.Usuario?.NomeUsuario</td>
                                <td>@log.Acao</td>
                                <td>@log.Tabela</td>
                                <td class="text-end">@log.IdRegistro</td>
                                <td>@log.Observacao</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bloquearMenu();

            const form = document.getElementById("formConsultaLogs");
            const btnImprimir = document.querySelector(".btn-gradiente-imprimir");
            const camposObrigatorios = [""];

            if (form) {
                ValidacaoUtils.configurarValidacaoCampos(form, camposObrigatorios, "LOGS");

                if (window.FormUtils && typeof FormUtils.enableEnterNavigation === 'function') {
                    FormUtils.enableEnterNavigation(form, { allowTextarea: true });
                }
            }

            if (btnImprimir) {
                btnImprimir.addEventListener("click", function (e) {
                    e.preventDefault();

                    // Captura os valores dos filtros
                    const inicio = document.getElementById("inicio").value;
                    const fim = document.getElementById("fim").value;
                    const usuario = document.getElementById("usuarioSelect").value;
                    const acao = document.getElementById("Acao").value;
                    const column = "Timestamp";

                    // Monta a URL da action LogsPdf
                    let url = "/Logs/LogsPdf?";
                    const params = [];

                    if (inicio) params.push("inicio=" + encodeURIComponent(inicio));
                    if (fim) params.push("fim=" + encodeURIComponent(fim));
                    if (usuario) params.push("usuario=" + encodeURIComponent(usuario));
                    if (acao) params.push("acao=" + encodeURIComponent(acao));
                    if (column) params.push("column=" + encodeURIComponent(column));

                    if (params.length > 0) {
                        url += params.join("&");
                    }

                    window.open(url, "_blank");

                    form.reset();
                });
            }
        });
    </script>
}