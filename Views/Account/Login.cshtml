@model Ordem_Servicos_Web.Models.Usuario

@{
    ViewData["Title"] = "Login";
}

<partial name="_MensagemToast" />

<div class="login-page gradient-bg d-flex justify-content-center align-items-center ">
    <div class="card shadow-lg translucent-box card-login">
        <div class="card-body">
            <h2 class="text-center mb-4">@ViewData["Title"]</h2>

            <form asp-action="Login" asp-controller="Account" method="post" id="formLogin" 
                data-campos-obrigatorios="Login, Senha">

                <div class="mb-3">
                    <label for="Login" class="form-label label-destaque">Login</label>
                    <input name="Login" id="Login" class="form-control input-login login Invalid" tabindex="1" data-focus="true" />
                </div>

                <div class="mb-4">
                    <label for="Senha" class="form-label label-destaque">Senha</label>
                    <input name="Senha" id="Senha" type="password" class="form-control input-login senha Invalid" tabindex="2" />
                </div>

                <!-- Container da imagem e NomeUsuario -->
                <div id="userImageContainer" class="text-center mb-3" style="display:none;">
                    <img id="userImage" src="" alt="Imagem do usuário" class="img-thumbnail imagemGet imagem-estilo" />
                    <p id="nomeUsuario" class="fw-bold mt-2"></p>
                </div>

                <!-- Botões -->
                <div class="d-flex justify-content-center align-items-center">
                    <button type="submit" id="btnEntrar" class="btn-gradiente btn-gradiente-entrar" tabindex="3">
                        <i class="fa fa-sign-in-alt me-2 move-icone-dir"></i> Entrar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bloquearMenu();

            const loginInput = document.getElementById("Login");
            const senhaInput = document.getElementById("Senha");
            const userImageContainer = document.getElementById("userImageContainer");
            const userImage = document.getElementById("userImage");
            const nomeUsuario = document.getElementById("nomeUsuario");
            const form = document.getElementById("formLogin");
            const btnEntrar = document.getElementById("btnEntrar");

            const camposObrigatorios = [
                "Login",
                "Senha"
            ];

            if (form) {
                ValidacaoUtils.configurarValidacaoCampos(form, camposObrigatorios, "USUARIOS");

                if (window.FormUtils && typeof FormUtils.enableEnterNavigation === 'function') {
                    FormUtils.enableEnterNavigation(form, { allowTextarea: true });
                }
            }

            if (btnEntrar && form) {
                btnEntrar.addEventListener("click", function (e) {
                    btnEntrar.focus();
                    const enterEvent = new KeyboardEvent("keydown", {
                        key: "Enter",
                        code: "Enter",
                        bubbles: true
                    });
                    btnEntrar.dispatchEvent(enterEvent);
                    form.requestSubmit();
                });

                btnEntrar.addEventListener("keydown", function (e) {

                    if (e.key === "Enter") {
                        form.requestSubmit();
                    }
                });
            }
        });
    </script>
}