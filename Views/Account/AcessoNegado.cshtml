@{
    ViewData["Title"] = "Acesso Negado";
}

<div class="container mt-5 text-center">
    <div class="card shadow-lg border-danger">
        <div class="card-body">
            <h2 class="text-danger">
                <i class="fa fa-ban me-2 move-icone-esq"></i> Acesso Negado
            </h2>
            <p class="mt-3">
                Você não tem Autorização para Acessar esta Página ou Executar esta Ação.
            </p>
            <p class="text-muted">
                Se Você Acredita que isso é um Erro, Entre em Contato com o Administrador do Sistema.
            </p>
            <div class="mt-4">
                 <a asp-controller="Home" asp-action="Index" class="btn-gradiente btn-gradiente-cancelar">
                    <i class="fa fa-home me-2 move-icone-esq"></i> Voltar ao Início
                </a>
                 <a asp-controller="Account" asp-action="Logout" class="btn-gradiente btn-gradiente-sair ms-2">
                    <i class="fa fa-sign-out-alt me-2 move-icone-esq"></i> Logout
                </a>
            </div>
        </div>
    </div>
</div>
