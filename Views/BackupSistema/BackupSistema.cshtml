@{
    ViewData["Title"] = "Backup Sistema.";
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<partial name="_MensagemToast" />

<modal-confirmacao id-modal="confirmaBackupSistema"
                   icone="fa fa-floppy-disk"
                   titulo="Confirmação"
                   mensagem="Deseja Realizar o Backup do Sistema Agora?"
                   classe-mensagem="mensagem-sucesso-modal"
                   action-controller="BackupSistema"
                   action-name="BackupSistema"
                   id-registro=""
                   icone-botao-principal="fa fa-floppy-disk"
                   texto-botao-principal="Executar Backup"
                   classe-botao-principal="btn-gradiente-executar"
                   texto-botao-cancelar="Cancelar/Voltar"
                   classe-botao-secundario="btn-gradiente-cancelar"
                   action-controller-secundario="Home"
                   action-name-secundario="Index">
</modal-confirmacao>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            bloquearMenu();

            var modalElement = document.getElementById("confirmaBackupSistema");
            if (modalElement) {
                var modal = new bootstrap.Modal(modalElement);
                modal.show();
            }
        });
    </script>
}