@model Ordem_Servicos_Web.Models.Permissao

@{
    ViewData["Title"] = "Alterar Permissão";
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<partial name="_MensagemToast" />

<div class="d-flex justify-content-center align-items-center ">
    <div class="card-form">
        <div class="card-body">
            <form asp-action="Alterar" method="post" id="formPermissao" enctype="multipart/form-data">
                <input type="hidden" asp-for="IdPermissao" />

                <!-- Linha 1 -->
                <div class="row mb-2 g-4">
                    <div class="col-auto">
                        <label class="label-destaque">Nome do Usuário</label>
                        <input type="text" class="form-control" value="@Model.Usuario?.NomeUsuario" readonly style="width:450px;" />
                    </div>
                    <div class="col-auto">
                        <label class="label-destaque">Opção do Menu</label>
                        <input type="text" class="form-control" value="@Model.Menu?.Descricao" readonly style="width:250px;" />
                    </div>


                    <div class="col-auto">
                        <label class="label-destaque">Opção SubIten do Menu</label>
                        <input type="text" class="form-control" value="@Model.ItensMenu?.Descricao" readonly style="width:250px;" />
                    </div>
                </div>

                <!-- Linha 2 -->
                <div class="row mb-2 g-4 align-items-center" style="margin-left:0.5em;">
                    <div class="col-auto form-check form-switch d-flex align-items-center">
                        <input asp-for="Executar" id="Executar" class="form-check-input toggle-switch" style="width:3em;" type="checkbox" data-focus="true" />
                        <label class="form-check-label label-destaque ms-2">Pode Executar</label>
                    </div>
                    <div class="col-auto form-check form-switch d-flex align-items-center">
                        <input asp-for="Criar" id="Criar" class="form-check-input toggle-switch" style="width:3em;" type="checkbox" />
                        <label class="form-check-label label-destaque ms-2">Pode Criar</label>
                    </div>

                    <div class="col-auto form-check form-switch d-flex align-items-center">
                        <input asp-for="Alterar" id="Alterar" class="form-check-input toggle-switch" style="width:3em;" type="checkbox" />
                        <label class="form-check-label label-destaque ms-2">Pode Alterar</label>
                    </div>

                    <div class="col-auto form-check form-switch d-flex align-items-center">
                        <input asp-for="Excluir" id="Excluir" class="form-check-input toggle-switch" style="width:3em;" type="checkbox" />
                        <label class="form-check-label label-destaque ms-2">Pode Excluir</label>
                    </div>
                </div>

                <!-- Botões -->
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" id="btnSalvar" class="btn-gradiente btn-gradiente-salvar">
                        <i class="fa fa-floppy-disk move-icone-esq"></i> Salvar Alterações
                    </button>
                    <a asp-action="Index" class="btn-gradiente btn-gradiente-cancelar">
                        <i class="fa fa-undo move-icone-esq"></i> Cancelar/Voltar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            bloquearMenu();

            const btnSalvar = document.getElementById("btnSalvar");
            const form = document.getElementById("formPermissao");

            const camposObrigatorios = [
                ""
            ];

            if (form) {
                ValidacaoUtils.configurarValidacaoCampos(form, camposObrigatorios, "PERMISSOES");

                if (window.FormUtils && typeof FormUtils.enableEnterNavigation === 'function') {
                    FormUtils.enableEnterNavigation(form, { allowTextarea: true });
                }
            }

            if (btnSalvar && form) {
                btnSalvar.addEventListener("click", function(e) {
                    btnSalvar.focus();
                    const enterEvent = new KeyboardEvent("keydown", {
                        key: "Enter",
                        code: "Enter",
                        bubbles: true
                    });
                    btnSalvar.dispatchEvent(enterEvent);
                    form.requestSubmit();
                });

                btnSalvar.addEventListener("keydown", function(e) {
                    if (e.key === "Enter") {
                        form.requestSubmit();
                    }
                });
            }
        });
    </script>
}